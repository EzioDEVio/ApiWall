# Reviewer access (required to use /review). Never commit real values.
# REVIEWER_TOKEN_SHA256 is the SHA-256 hex digest of a long random reviewer token.
# Generate one:  node -e "const t=require('crypto').randomBytes(32).toString('base64url');console.log('token:',t);console.log('sha256:',require('crypto').createHash('sha256').update(t).digest('hex'))"
REVIEWER_TOKEN_SHA256=
# At least 32 random characters; signs reviewer session cookies.
REVIEW_SESSION_SECRET=
# Optional: where submissions and the audit log are stored (default: data/runtime).
TESSERA_DATA_DIR=
