{
  "name": "apiwall",
  "version": "0.1.0",
  "private": true,
  "description": "An interactive mosaic for discovering public APIs, built from the public-apis/public-apis catalog.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "catalog:import": "tsx scripts/import-catalog.ts",
    "catalog:logos": "tsx scripts/fetch-logos.ts && tsx scripts/optimize-logos.ts && tsx scripts/import-catalog.ts --offline",
    "check:secrets": "tsx scripts/scan-secrets.ts",
    "prebuild": "tsx scripts/check-data.ts",
    "predev": "tsx scripts/check-data.ts",
    "prestart": "tsx scripts/check-data.ts && tsx scripts/check-start.ts",
    "reviewer:setup": "tsx scripts/setup-reviewer.ts",
    "build:static": "node scripts/build-static.mjs",
    "logos:add": "tsx scripts/community-logos.ts add",
    "logos:remove": "tsx scripts/community-logos.ts remove",
    "logos:promote": "tsx scripts/community-logos.ts promote",
    "media:demo": "tsx scripts/record-demo.ts",
    "preview:static": "node scripts/build-static.mjs --base /ApiWall && node scripts/serve-static.mjs --base /ApiWall",
    "logos:optimize": "tsx scripts/optimize-logos.ts",
    "links:check": "tsx scripts/check-links.ts",
    "sync:report": "tsx scripts/sync-report.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@iconify-json/tabler": "1.2.42",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "gifenc": "^1.0.3",
    "jsdom": "26.1.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "simple-icons": "13.21.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25"
    }
  }
}
